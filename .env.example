# ============================================
# ZAPATEAN2 — Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys.

# OpenRouteService API Key (SERVER-SIDE ONLY — never exposed to the browser)
# The app uses a server-side API proxy at /api/route to protect this key.
# Get yours at: https://openrouteservice.org/dev/#/home → Tokens → Create Token
ORS_API_KEY=YOUR_ORS_API_KEY_HERE

# Stadia Maps API Key (PUBLIC — used in tile URLs)
# This key is inherently public (embedded in tile requests). Protect it by
# restricting allowed domains in your Stadia dashboard to: zapatean2.vercel.app
# Get yours at: https://client.stadiamaps.com/
PUBLIC_STADIA_API_KEY=YOUR_STADIA_API_KEY_HERE
