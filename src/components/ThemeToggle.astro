---
/**
 * ThemeToggle.astro — Day/Night mode toggle with crisp SVG icons
 * Part of the right-side action rail (stacked with GPS button)
 */
---

<button
  id="theme-toggle"
  class="fab-button theme-toggle"
  aria-label="Cambiar tema día/noche"
  title="Cambiar tema"
>
  <!-- Sun icon (day mode active) -->
  <svg id="icon-sun" class="theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>

  <!-- Moon icon (night mode active) -->
  <svg id="icon-moon" class="theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script>
  import { $theme, toggleTheme } from '../lib/stores';
  import { vibrateTap } from '../lib/haptics';

  const btn = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('icon-sun');
  const moonIcon = document.getElementById('icon-moon');

  function updateIcon(theme: string) {
    if (sunIcon && moonIcon) {
      sunIcon.style.display = theme === 'day' ? 'block' : 'none';
      moonIcon.style.display = theme === 'night' ? 'block' : 'none';
    }
  }

  updateIcon($theme.get());
  $theme.subscribe(updateIcon);

  btn?.addEventListener('click', () => {
    toggleTheme();
    vibrateTap();
  });
</script>

<style>
  /* Styles handled by .fab-button in global.css */
  .theme-toggle {
    /* No additional styles needed — positioned by action-rail in index.astro */
  }

  .theme-icon {
    transition: transform 0.35s ease;
  }

  .theme-toggle:active .theme-icon {
    transform: rotate(25deg) scale(0.88);
  }
</style>
