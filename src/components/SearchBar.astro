---
/**
 * SearchBar.astro — Premium address search overlay with Nominatim geocoding
 * Features: safe-area aware, loading spinner, integrated theme toggle, debounced search
 */
---

<div id="search-overlay" class="search-overlay">
  <div class="search-bar">
    <!-- Search Icon (or loading spinner) -->
    <div class="search-icon-wrapper">
      <svg id="search-icon-static" class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <div id="search-spinner" class="search-spinner" style="display:none;"></div>
    </div>

    <!-- Input -->
    <input
      type="text"
      id="search-address"
      class="search-address-input"
      placeholder="¿A dónde vas?"
      autocomplete="off"
      spellcheck="false"
    />

    <!-- Clear button -->
    <button id="search-clear" class="search-clear-btn" style="display:none;" aria-label="Limpiar búsqueda">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Results dropdown -->
  <div id="search-results" class="search-results" style="display:none;"></div>
</div>

<script>
  import { $searchResults, $isSearching, $userPosition, $sheetState, addStop, $activeTab } from '../lib/stores';
  import { flyTo } from './MapClient';
  import { vibrateTap } from '../lib/haptics';
  import { calculateAllProfiles } from '../lib/routing';
  import type { GeocodingResult } from '../lib/types';

  const input = document.getElementById('search-address') as HTMLInputElement;
  const resultsContainer = document.getElementById('search-results')!;
  const clearBtn = document.getElementById('search-clear')!;
  const searchIconStatic = document.getElementById('search-icon-static')!;
  const searchSpinner = document.getElementById('search-spinner')!;

  let debounceTimer: ReturnType<typeof setTimeout>;

  // ---- Loading state feedback ----
  $isSearching.subscribe((searching) => {
    searchIconStatic.style.display = searching ? 'none' : 'block';
    searchSpinner.style.display = searching ? 'block' : 'none';
  });

  // ---- Nominatim Geocoding ----
  async function searchAddress(query: string): Promise<GeocodingResult[]> {
    if (query.length < 3) return [];

    $isSearching.set(true);

    try {
      const params = new URLSearchParams({
        q: query,
        format: 'json',
        limit: '5',
        countrycodes: 'cu',
        addressdetails: '1',
        'accept-language': 'es',
      });

      const response = await fetch(
        `https://nominatim.openstreetmap.org/search?${params}`,
        {
          headers: {
            'User-Agent': 'Zapatean2/1.0 (PWA Cuba Routes)',
          },
        }
      );

      if (!response.ok) return [];
      return await response.json();
    } catch (err) {
      console.error('[Zapatean2] Geocoding error:', err);
      return [];
    } finally {
      $isSearching.set(false);
    }
  }

  // ---- Render results ----
  function renderResults(results: GeocodingResult[]) {
    if (results.length === 0) {
      resultsContainer.style.display = 'none';
      return;
    }

    resultsContainer.innerHTML = results
      .map((r) => {
        // Smart label: show first part as title, rest as subtitle
        const parts = r.display_name.split(',');
        const title = parts.slice(0, 1).join('').trim();
        const subtitle = parts.slice(1, 3).join(',').trim();

        return `
        <button class="search-result-item" data-lat="${r.lat}" data-lon="${r.lon}" data-name="${r.display_name}">
          <div class="result-icon-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div class="result-content">
            <span class="result-title">${title}</span>
            <span class="result-subtitle">${subtitle}</span>
          </div>
        </button>
      `;
      })
      .join('');

    resultsContainer.style.display = 'block';

    // Attach click handlers
    resultsContainer.querySelectorAll('.search-result-item').forEach((item) => {
      item.addEventListener('click', () => {
        const lat = parseFloat((item as HTMLElement).dataset.lat!);
        const lon = parseFloat((item as HTMLElement).dataset.lon!);
        const fullName = (item as HTMLElement).dataset.name!;
        const shortName = fullName.split(',').slice(0, 2).join(',').trim();

        const pos = { lat, lng: lon };
        flyTo(lat, lon, 15);

        const stop = addStop(pos, shortName);
        if (stop) {
          calculateAllProfiles();
        }

        $sheetState.set('half');
        $activeTab.set('route');
        input.value = '';
        resultsContainer.style.display = 'none';
        clearBtn.style.display = 'none';
        input.blur(); // dismiss keyboard
        vibrateTap();
      });
    });
  }

  // ---- Input handlers ----
  input.addEventListener('input', () => {
    const query = input.value.trim();
    clearBtn.style.display = query ? 'flex' : 'none';

    clearTimeout(debounceTimer);

    if (query.length < 3) {
      resultsContainer.style.display = 'none';
      $searchResults.set([]);
      return;
    }

    debounceTimer = setTimeout(async () => {
      const results = await searchAddress(query);
      $searchResults.set(results);
      renderResults(results);
    }, 400);
  });

  input.addEventListener('focus', () => {
    const results = $searchResults.get();
    if (results.length > 0) renderResults(results);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    resultsContainer.style.display = 'none';
    clearBtn.style.display = 'none';
    $searchResults.set([]);
    input.focus();
    vibrateTap();
  });

  document.addEventListener('click', (e) => {
    const overlay = document.getElementById('search-overlay');
    if (overlay && !overlay.contains(e.target as Node)) {
      resultsContainer.style.display = 'none';
    }
  });
</script>

<style>
  .search-overlay {
    position: fixed;
    top: calc(0.625rem + env(safe-area-inset-top, 0px));
    left: 0.75rem;
    right: 0.75rem;
    z-index: 950;
  }

  .search-bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 3rem;
  }

  /* Icon wrapper (search or spinner) */
  .search-icon-wrapper {
    position: absolute;
    left: 0.875rem;
    width: 1.25rem;
    height: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 2;
  }

  .search-icon {
    color: var(--text-muted);
  }

  .search-spinner {
    width: 1.125rem;
    height: 1.125rem;
    border: 2px solid oklch(0.5 0 0 / 0.15);
    border-top-color: var(--color-brand-500);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Input */
  .search-address-input {
    width: 100%;
    height: 3rem;
    padding: 0 2.75rem 0 3rem;
    border-radius: 1rem;
    border: 1px solid oklch(0.5 0 0 / 0.08);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 0.9375rem;
    font-family: var(--font-sans);
    font-weight: 500;
    outline: none;
    box-shadow:
      0 1px 3px oklch(0 0 0 / 0.06),
      0 4px 16px oklch(0 0 0 / 0.08);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-address-input:focus {
    border-color: var(--color-brand-400);
    box-shadow:
      0 1px 3px oklch(0 0 0 / 0.06),
      0 4px 20px oklch(0 0 0 / 0.12),
      0 0 0 3px oklch(0.55 0.20 250 / 0.08);
  }

  .search-address-input::placeholder {
    color: var(--text-muted);
    font-weight: 400;
  }

  /* Clear button */
  .search-clear-btn {
    position: absolute;
    right: 0.5rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: oklch(0.5 0 0 / 0.08);
    border: none;
    border-radius: 50%;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .search-clear-btn:hover {
    background: oklch(0.5 0 0 / 0.15);
    color: var(--text);
  }

  .search-clear-btn:active {
    transform: scale(0.9);
  }

  /* Results Dropdown */
  .search-results {
    margin-top: 0.5rem;
    background: var(--bg-elevated);
    border-radius: 1rem;
    border: 1px solid oklch(0.5 0 0 / 0.06);
    box-shadow:
      0 4px 12px oklch(0 0 0 / 0.08),
      0 12px 40px oklch(0 0 0 / 0.12);
    overflow: hidden;
    max-height: 18rem;
    overflow-y: auto;
    animation: fadeDropdown 0.2s ease;
  }

  @keyframes fadeDropdown {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.search-result-item) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.75rem 1rem;
    background: none;
    border: none;
    border-bottom: 1px solid oklch(0.5 0 0 / 0.05);
    color: var(--text);
    font-family: var(--font-sans);
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  :global(.search-result-item:last-child) {
    border-bottom: none;
  }

  :global(.search-result-item:hover) {
    background: oklch(0.5 0 0 / 0.04);
  }

  :global(.search-result-item:active) {
    background: oklch(0.55 0.20 250 / 0.08);
  }

  :global(.result-icon-wrap) {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: oklch(0.55 0.20 250 / 0.08);
    border-radius: 0.5rem;
    color: var(--color-brand-500);
    flex-shrink: 0;
  }

  :global(.result-content) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  :global(.result-title) {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.result-subtitle) {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
