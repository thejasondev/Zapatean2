---
/**
 * FavoritesPanel.astro — Saved routes management
 */
---

<div id="favorites-panel" class="favorites-panel">
  <!-- Empty state -->
  <div id="favorites-empty" class="favorites-empty">
    <div class="favorites-empty-icon">⭐</div>
    <p class="favorites-empty-text">No tienes rutas guardadas</p>
    <p class="favorites-empty-hint">Calcula una ruta y guárdala para acceder rápido</p>
  </div>

  <!-- Favorites list -->
  <div id="favorites-list" class="favorites-list" style="display:none;"></div>

  <!-- Save current route CTA (only shows when there's an active route) -->
  <div id="favorites-save-cta" class="favorites-save-cta" style="display:none;">
    <button id="btn-save-favorite" class="btn-save-favorite">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
      </svg>
      <span>Guardar ruta actual</span>
    </button>
  </div>
</div>

<!-- Modal for naming favorite -->
<dialog id="favorite-modal" class="favorite-modal">
  <div class="modal-content">
    <h3 class="modal-title">Guardar Ruta</h3>
    <p class="modal-desc">Asigna un nombre a esta ruta para encontrarla fácilmente.</p>
    <input type="text" id="favorite-name-input" class="modal-input" placeholder="Ej: Casa → Almacén" />
    <div class="modal-actions">
      <button id="btn-cancel-favorite" class="modal-btn modal-btn--ghost">Cancelar</button>
      <button id="btn-confirm-favorite" class="modal-btn modal-btn--primary">Guardar</button>
    </div>
  </div>
</dialog>

<script>
  import { $favorites, $currentRoute, $stops, $routeParams, $activeTab } from '../lib/stores';
  import { saveFavorite, loadFavorites, deleteFavorite } from '../lib/db';
  import { formatDistance, formatDuration, calculateAllProfiles } from '../lib/routing';
  import { vibrateTap, vibrateConfirm } from '../lib/haptics';
  import type { FavoriteRoute } from '../lib/types';

  const emptyEl = document.getElementById('favorites-empty')!;
  const listEl = document.getElementById('favorites-list')!;
  const saveCta = document.getElementById('favorites-save-cta')!;
  const btnSave = document.getElementById('btn-save-favorite')!;
  
  // Modal
  const modal = document.getElementById('favorite-modal') as HTMLDialogElement;
  const inputName = document.getElementById('favorite-name-input') as HTMLInputElement;
  const btnCancel = document.getElementById('btn-cancel-favorite')!;
  const btnConfirm = document.getElementById('btn-confirm-favorite')!;

  // ---- Load Favorites on Mount ----
  loadFavorites().then((favs) => {
    $favorites.set(favs);
  });

  // ---- Render List ----
  function renderFavorites() {
    const favs = $favorites.get();

    if (favs.length === 0) {
      emptyEl.style.display = 'flex';
      listEl.style.display = 'none';
      return;
    }

    emptyEl.style.display = 'none';
    listEl.style.display = 'flex';

    listEl.innerHTML = favs.map((fav) => `
      <div class="fav-card" data-fav-id="${fav.id}">
        <div class="fav-info">
          <div class="fav-title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span>${fav.name}</span>
          </div>
          <div class="fav-meta">
            <span>${fav.stops.length} paradas</span>
            <span class="dot">•</span>
            <span>${formatDistance(fav.totalDistance)}</span>
            <span class="dot">•</span>
            <span class="fav-transport">
              ${fav.profile === 'driving-car' ? '🚗' : fav.profile === 'cycling-electric' ? '🏍️' : fav.profile === 'cycling-regular' ? '🚲' : '🚶'}
            </span>
          </div>
        </div>
        <div class="fav-actions">
          <button class="fav-btn fav-btn--load" data-load-id="${fav.id}" title="Cargar ruta">Cargar</button>
          <button class="fav-btn fav-btn--delete" data-delete-id="${fav.id}" title="Eliminar favorito">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          </button>
        </div>
      </div>
    `).join('');

    // Attach event listeners for delete and load
    listEl.querySelectorAll('.fav-btn--delete').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        vibrateTap();
        const id = (btn as HTMLElement).dataset.deleteId!;
        await deleteFavorite(id);
        $favorites.set($favorites.get().filter(f => f.id !== id));
      });
    });

    listEl.querySelectorAll('.fav-btn--load').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        vibrateTap();
        const id = (btn as HTMLElement).dataset.loadId!;
        const fav = $favorites.get().find(f => f.id === id);
        if (fav) {
          // Restore stops and profile
          $stops.set([...fav.stops]);
          $routeParams.set({ ...$routeParams.get(), profile: fav.profile });
          // Switch to route tab and calculate
          $activeTab.set('route');
          calculateAllProfiles();
        }
      });
    });
  }

  $favorites.subscribe(renderFavorites);

  // ---- Save CTA Visibility ----
  $currentRoute.subscribe((route) => {
    if (route) {
      saveCta.style.display = 'block';
    } else {
      saveCta.style.display = 'none';
    }
  });

  // ---- Save Modal Logic ----
  btnSave.addEventListener('click', () => {
    vibrateTap();
    inputName.value = '';
    modal.showModal();
  });

  btnCancel.addEventListener('click', () => {
    modal.close();
  });

  btnConfirm.addEventListener('click', async () => {
    const name = inputName.value.trim() || 'Ruta sin nombre';
    const route = $currentRoute.get();
    const params = $routeParams.get();
    const currentStops = $stops.get();

    if (!route) return;

    vibrateConfirm();

    const newFav: FavoriteRoute = {
      id: `fav_${Date.now()}`,
      name,
      stops: [...currentStops],
      totalDistance: route.distance,
      totalDuration: route.duration,
      estimatedCost: 0, // Simplified for now
      profile: params.profile,
      createdAt: Date.now()
    };

    await saveFavorite(newFav);
    $favorites.set([newFav, ...$favorites.get()]);
    
    modal.close();
  });
</script>

<style>
  .favorites-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Empty state */
  .favorites-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .favorites-empty-icon {
    font-size: 2rem;
    line-height: 1;
    opacity: 0.8;
  }

  .favorites-empty-text {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }

  .favorites-empty-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* List */
  .favorites-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 20rem;
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  .fav-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: var(--bg);
    border: 1px solid oklch(0.5 0 0 / 0.08);
  }

  .fav-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .fav-title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }

  .fav-title svg {
    color: #eab308;
  }

  .fav-meta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .dot {
    opacity: 0.4;
  }

  .fav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .fav-btn {
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.15s ease;
  }

  .fav-btn--load {
    background: var(--color-brand-500);
    color: white;
    padding: 0.375rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .fav-btn--load:active {
    filter: brightness(1.1);
    transform: scale(0.95);
  }

  .fav-btn--delete {
    background: oklch(0.5 0 0 / 0.06);
    color: var(--text-muted);
    padding: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fav-btn--delete:hover {
    background: oklch(0.6 0.15 25 / 0.15);
    color: oklch(0.55 0.2 25);
  }

  /* Save CTA */
  .favorites-save-cta {
    margin-top: 0.5rem;
  }

  .btn-save-favorite {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem;
    border: 1px dashed oklch(0.5 0 0 / 0.2);
    border-radius: 0.75rem;
    background: oklch(0.5 0 0 / 0.02);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-save-favorite:hover {
    border-color: var(--color-brand-400);
    background: oklch(0.55 0.20 250 / 0.05);
    color: var(--color-brand-500);
  }

  /* Modal */
  .favorite-modal {
    padding: 0;
    border: none;
    border-radius: 1rem;
    background: var(--bg);
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    backdrop-filter: blur(10px);
    width: calc(100% - 3rem);
    max-width: 400px;
    margin: auto;
  }

  .favorite-modal::backdrop {
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .modal-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
  }

  .modal-desc {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .modal-input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid oklch(0.5 0 0 / 0.15);
    border-radius: 0.5rem;
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    margin-top: 0.5rem;
  }

  .modal-input:focus {
    outline: none;
    border-color: var(--color-brand-500);
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .modal-btn {
    padding: 0.625rem 1rem;
    border-radius: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
  }

  .modal-btn--ghost {
    background: transparent;
    color: var(--text-muted);
  }

  .modal-btn--ghost:hover {
    background: oklch(0.5 0 0 / 0.06);
  }

  .modal-btn--primary {
    background: var(--color-brand-500);
    color: white;
  }
</style>
