---
/**
 * StopsList.astro — Multi-stop delivery panel
 * Shows numbered stops, optimize button, clear all.
 */
import { MAX_STOPS } from '../lib/types';
---

<div id="stops-panel" class="stops-panel">
  <!-- Empty state -->
  <div id="stops-empty" class="stops-empty">
    <div class="stops-empty-icon">📍</div>
    <p class="stops-empty-text">Toca el mapa para agregar paradas</p>
    <p class="stops-empty-hint">Hasta {MAX_STOPS} paradas · Tu GPS es el origen</p>
  </div>

  <!-- Stops list -->
  <div id="stops-list" class="stops-list" style="display:none;"></div>

  <!-- Actions bar -->
  <div class="stops-footer">
    <div id="stops-actions" class="stops-actions" style="display:none;">
      <button id="btn-optimize" class="stops-btn stops-btn--accent" title="Optimizar orden de paradas">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="17 1 21 5 17 9"/>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
          <polyline points="7 23 3 19 7 15"/>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
        </svg>
        <span>Optimizar</span>
      </button>
      <button id="btn-clear-stops" class="stops-btn stops-btn--ghost" title="Limpiar todas las paradas">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
        </svg>
        <span>Limpiar</span>
      </button>
    </div>
    
    <button id="btn-finish-trip" class="stops-btn stops-btn--finish" style="display:none;" title="Terminar y Guardar en Billetera">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <span>Finalizar Viaje</span>
    </button>
  </div>

  <!-- Counter -->
  <div id="stops-counter" class="stops-counter" style="display:none;">
    <span id="stops-count-text"></span>
  </div>
</div>

<script>
  import { $stops, $userPosition, removeStop, clearRoute, renameStop, $currentRoute, $costConfig, $routeParams, $sheetState, $tripRecords } from '../lib/stores';
  import { optimizeStopOrder, calculateAllProfilesDebounced } from '../lib/routing';
  import { vibrateTap } from '../lib/haptics';
  import { MAX_STOPS } from '../lib/types';
  import { saveTripRecord, loadTripRecords } from '../lib/db';
  import { generateReceiptAndShare } from '../lib/receipt';

  const emptyEl = document.getElementById('stops-empty')!;
  const listEl = document.getElementById('stops-list')!;
  const actionsEl = document.getElementById('stops-actions')!;
  const counterEl = document.getElementById('stops-counter')!;
  const countText = document.getElementById('stops-count-text')!;
  const btnOptimize = document.getElementById('btn-optimize')!;
  const btnClear = document.getElementById('btn-clear-stops')!;
  const btnFinish = document.getElementById('btn-finish-trip')!;

  function renderStops() {
    const stops = $stops.get();
    const hasGps = !!$userPosition.get();

    if (stops.length === 0) {
      emptyEl.style.display = 'flex';
      listEl.style.display = 'none';
      actionsEl.style.display = 'none';
      btnFinish.style.display = 'none';
      counterEl.style.display = 'none';
      return;
    }

    emptyEl.style.display = 'none';
    listEl.style.display = 'flex';
    actionsEl.style.display = 'flex';
    btnFinish.style.display = 'flex';
    counterEl.style.display = 'flex';

    countText.textContent = `${stops.length}/${MAX_STOPS} paradas`;

    listEl.innerHTML = stops
      .sort((a, b) => a.order - b.order)
      .map((stop) => `
        <div class="stop-card ${stop.completed ? 'stop-card--done' : ''}" data-stop-id="${stop.id}">
          <div class="stop-number" style="background:${stop.completed ? '#22c55e' : '#ef4444'}">
            ${stop.completed ? '✓' : stop.order + 1}
          </div>
          <div class="stop-info">
            <span class="stop-label" contenteditable="true" spellcheck="false" data-edit-id="${stop.id}">${stop.label}</span>
            <span class="stop-coords">${stop.position.lat.toFixed(4)}, ${stop.position.lng.toFixed(4)}</span>
          </div>
          <button class="stop-wa" data-wa-index="${stop.order}" aria-label="Avisar por WhatsApp" title="Enviar ETA por WhatsApp">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </button>
          <button class="stop-remove" data-remove-id="${stop.id}" aria-label="Eliminar parada" title="Eliminar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
      `)
      .join('');

    // Remove buttons
    listEl.querySelectorAll('.stop-remove').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.removeId!;
        removeStop(id);
        vibrateTap();
        // Recalculate if still have stops
        if ($stops.get().length > 0) calculateAllProfilesDebounced();
      });
    });

    // Rename labels
    listEl.querySelectorAll('.stop-label').forEach((lbl) => {
      lbl.addEventListener('blur', (e) => {
        const target = e.target as HTMLElement;
        const id = target.dataset.editId!;
        const newText = target.textContent?.trim() || '';
        if (newText) {
          renameStop(id, newText);
        }
      });
      lbl.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter') {
          e.preventDefault();
          (e.target as HTMLElement).blur();
        }
      });
    });

    // WhatsApp logic
    listEl.querySelectorAll('.stop-wa').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        vibrateTap();
        
        const route = $currentRoute.get();
        const config = $costConfig.get();
        let distKm = 0;
        let timeMin = 0;
        let price = 0;

        if (route) {
          distKm = route.distance / 1000;
          timeMin = Math.ceil(route.duration / 60);
          
          const manualInput = document.getElementById('config-manual-total') as HTMLInputElement;
          const manual = manualInput ? manualInput.value : '';
          price = manual ? parseInt(manual) : Math.round(distKm * config.pricePerKm);
        }
        
        const distStr = distKm > 0 ? ` me encuentro a ${distKm.toFixed(1)} km y llego en aproximadamente ${timeMin} minutos.` : ' voy en camino.';
        const priceStr = price > 0 ? ` El total es $${price} CUP.` : '';
        const msg = `¡Hola! Soy tu mensajero.${distStr}${priceStr}`;
        
        window.open(`https://wa.me/?text=${encodeURIComponent(msg)}`, '_blank');
      });
    });
  }

  $stops.subscribe(renderStops);
  $userPosition.subscribe(renderStops);
  renderStops();

  // Optimize
  btnOptimize.addEventListener('click', () => {
    vibrateTap();
    optimizeStopOrder();
    calculateAllProfilesDebounced();
  });

  // Clear
  btnClear.addEventListener('click', () => {
    vibrateTap();
    clearRoute();
  });

  // Finish Trip
  btnFinish.addEventListener('click', async () => {
    vibrateTap();
    const route = $currentRoute.get();
    const config = $costConfig.get();
    const stops = $stops.get();
    
    if (!route || stops.length === 0) {
      alert("Traza una ruta primero para finalizarla.");
      return;
    }

    const manualInput = document.getElementById('config-manual-total') as HTMLInputElement;
    const manual = manualInput ? manualInput.value : '';
    const distKm = route.distance / 1000;
    const defaultCost = Math.round(distKm * config.pricePerKm);
    const finalVal = manual ? parseInt(manual) : defaultCost;

    // Custom Price Prompt Overlay
    const promptOverlay = document.createElement('div');
    promptOverlay.className = 'zap-modal-overlay';
    promptOverlay.innerHTML = `
      <div class="zap-modal">
        <div class="zap-modal-icon">💵</div>
        <h3 class="zap-modal-title">Finalizar Viaje</h3>
        <p class="zap-modal-text" style="margin-bottom: 0.5rem">Confirma el importe cobrado al cliente:</p>
        <div style="position:relative; margin-bottom: 1rem;">
          <span style="position:absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-weight: bold;">$</span>
          <input type="number" id="zap-price-input" class="zap-modal-input" value="${finalVal}" step="1" min="0" />
          <span style="position:absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.75rem;">CUP</span>
        </div>
        <div class="zap-modal-actions" style="margin-top:0">
          <button id="zap-price-cancel" class="zap-modal-btn zap-modal-btn--ghost">Cancelar</button>
          <button id="zap-price-confirm" class="zap-modal-btn zap-modal-btn--primary">Cobrar</button>
        </div>
      </div>
    `;
    document.body.appendChild(promptOverlay);

    const inputField = document.getElementById('zap-price-input') as HTMLInputElement;
    // Auto-focus the input
    setTimeout(() => inputField.focus(), 100);

    const closePrompt = () => {
      promptOverlay.classList.add('zap-modal-overlay--closing');
      setTimeout(() => promptOverlay.remove(), 250);
    };

    document.getElementById('zap-price-cancel')!.addEventListener('click', closePrompt);
    document.getElementById('zap-price-confirm')!.addEventListener('click', () => {
      const cost = parseInt(inputField.value) || 0;
      closePrompt();
      processTripFinish(cost, route, stops, distKm);
    });
  });

  // Extracted finish logic to run after custom prompt confirmation
  function processTripFinish(cost: number, route: any, stops: any[], distKm: number) {
    const record = {
      id: `trip_${Date.now()}`,
      date: Date.now(),
      distanceMeters: route.distance,
      totalCup: cost,
      stopsCount: stops.length,
      profile: $routeParams.get().profile || 'driving-car'
    };

    saveTripRecord(record).then(async () => {
      loadTripRecords().then(t => $tripRecords.set(t));
      const addresses = stops.map(s => s.label);
      clearRoute();
      $sheetState.set('collapsed');
      
      // Custom Notification Overlay
      const overlay = document.createElement('div');
      overlay.className = 'zap-modal-overlay';
      overlay.innerHTML = `
        <div class="zap-modal">
          <div class="zap-modal-icon">🎉</div>
          <h3 class="zap-modal-title">¡Viaje Completado!</h3>
          <p class="zap-modal-text">Has registrado una ganancia de <strong style="color:var(--color-brand-500)">$${cost} CUP</strong> en tu Billetera.</p>
          <p class="zap-modal-text">¿Deseas generar y compartir el recibo digital con tu cliente?</p>
          <div class="zap-modal-actions">
            <button id="zap-modal-no" class="zap-modal-btn zap-modal-btn--ghost">No, gracias</button>
            <button id="zap-modal-yes" class="zap-modal-btn zap-modal-btn--primary">Sí, enviar recibo</button>
          </div>
        </div>
      `;
      document.body.appendChild(overlay);

      const closeOverlay = () => {
        overlay.classList.add('zap-modal-overlay--closing');
        setTimeout(() => overlay.remove(), 250);
        // Switch to wallet to see the money!
        $activeTab.set('wallet');
        $sheetState.set('half');
      };

      document.getElementById('zap-modal-no')!.addEventListener('click', closeOverlay);
      document.getElementById('zap-modal-yes')!.addEventListener('click', () => {
        closeOverlay();
        generateReceiptAndShare({
          date: record.date,
          distanceKm: distKm,
          costCup: cost,
          stopsCount: record.stopsCount,
          addresses
        });
      });
    });
  }
</script>

<style>
  .stops-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Empty state */
  .stops-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .stops-empty-icon {
    font-size: 2rem;
    line-height: 1;
    opacity: 0.6;
  }

  .stops-empty-text {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }

  .stops-empty-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* List */
  .stops-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 0.25rem;
  }

  .stop-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.75rem;
    background: var(--bg);
    border: 1px solid oklch(0.5 0 0 / 0.06);
    transition: all 0.2s ease;
    animation: fadeIn 0.2s ease;
  }

  .stop-card--done {
    opacity: 0.5;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .stop-number {
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .stop-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
  }

  .stop-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    outline: none;
    padding: 0.125rem 0.25rem;
    margin-left: -0.25rem;
    border-radius: 0.25rem;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .stop-label:hover {
    background: oklch(0.5 0 0 / 0.04);
    border-color: oklch(0.5 0 0 / 0.1);
  }

  .stop-label:focus {
    background: var(--bg-elevated);
    border-color: var(--color-brand-400);
  }

  .stop-coords {
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-family: monospace;
  }

  .stop-remove {
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: oklch(0.5 0 0 / 0.06);
    border-radius: 50%;
    color: var(--text-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .stop-remove:hover {
    background: oklch(0.6 0.15 25 / 0.15);
    color: oklch(0.55 0.2 25);
  }

  .stop-remove:active {
    transform: scale(0.85);
  }

  .stop-wa {
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: oklch(0.5 0 0 / 0.04);
    border-radius: 50%;
    color: var(--color-brand-500);
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .stop-wa:hover {
    background: var(--color-brand-500);
    color: white;
  }

  .stops-footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  /* Actions */
  .stops-actions {
    display: flex;
    gap: 0.5rem;
  }

  .stops-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .stops-btn--finish {
    background: oklch(0.6 0.15 155); /* Elegant Green */
    color: white;
    width: 100%;
  }

  .stops-btn--finish:hover {
    filter: brightness(1.1);
  }

  .stops-btn--finish:active {
    transform: scale(0.97);
  }

  .stops-btn--accent {
    background: var(--color-brand-500);
    color: white;
  }

  .stops-btn--accent:hover {
    filter: brightness(1.08);
  }

  .stops-btn--accent:active {
    transform: scale(0.97);
  }

  .stops-btn--ghost {
    background: oklch(0.5 0 0 / 0.06);
    color: var(--text-muted);
  }

  .stops-btn--ghost:hover {
    background: oklch(0.5 0 0 / 0.12);
    color: var(--text);
  }

  .stops-counter {
    display: flex;
    justify-content: center;
    font-size: 0.6875rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* Custom Modal Styles injected globally */
  :global(.zap-modal-overlay) {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4); backdrop-filter: blur(4px);
    z-index: 10000;
    display: flex; align-items: center; justify-content: center;
    padding: 1.5rem;
    animation: zapFadeIn 0.25s ease forwards;
  }
  :global(.zap-modal-overlay--closing) {
    animation: zapFadeOut 0.2s ease forwards;
  }
  :global(.zap-modal) {
    background: var(--bg-elevated);
    border-radius: 1.25rem;
    padding: 1.5rem;
    width: 100%;
    max-width: 340px;
    box-shadow: 0 20px 40px oklch(0 0 0 / 0.2);
    text-align: center;
    transform: scale(0.95);
    opacity: 0;
    animation: zapPopIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.05s forwards;
  }
  :global(.zap-modal-icon) {
    font-size: 3rem; margin-bottom: 0.5rem;
  }
  :global(.zap-modal-title) {
    margin: 0 0 0.5rem; font-size: 1.25rem; color: var(--text); font-family: var(--font-sans); font-weight: 800;
  }
  :global(.zap-modal-text) {
    margin: 0 0 1rem; font-size: 0.875rem; color: var(--text-muted); font-family: var(--font-sans); line-height: 1.4;
  }
  :global(.zap-modal-actions) {
    display: flex; gap: 0.5rem; margin-top: 1.5rem;
  }
  :global(.zap-modal-input) {
    width: 100%; padding: 0.875rem 2.5rem 0.875rem 2rem; border-radius: 0.75rem; 
    border: 2px solid var(--color-brand-500); background: var(--bg);
    color: var(--text); font-size: 1.25rem; font-weight: 700; text-align: center;
    font-family: var(--font-sans); outline: none;
  }
  :global(.zap-modal-btn) {
    flex: 1; padding: 0.75rem; border-radius: 0.75rem; border: none; font-weight: 600; cursor: pointer; transition: all 0.2s; font-family: var(--font-sans);
  }
  :global(.zap-modal-btn--ghost) {
    background: oklch(0.5 0 0 / 0.06); color: var(--text);
  }
  :global(.zap-modal-btn--primary) {
    background: var(--color-brand-500); color: white;
  }
  @keyframes zapFadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes zapFadeOut { from { opacity: 1; } to { opacity: 0; } }
  @keyframes zapPopIn { to { transform: scale(1); opacity: 1; } }
</style>
