---
/**
 * CostDisplay.astro — Trip cost calculator card
 * Shows estimated cost + fuel usage, with editable config.
 */
import { TRANSPORT_OPTIONS } from '../lib/types';
---

<div id="cost-panel" class="cost-panel">
  <!-- Main cost display -->
  <div id="cost-result" class="cost-result" style="display:none;">
    <div class="cost-main">
      <span class="cost-amount" id="cost-total">—</span>
      <span class="cost-label">costo estimado</span>
    </div>
    <div id="cost-fuel" class="cost-fuel" style="display:none;">
      <span class="fuel-icon">⛽</span>
      <span id="cost-fuel-text">—</span>
    </div>
  </div>

  <!-- Transport cost breakdown -->
  <div id="cost-grid" class="cost-grid" style="display:none;">
    {TRANSPORT_OPTIONS.map((opt) => (
      <div class="cost-item" data-cost-profile={opt.id}>
        <span class="cost-item-icon">{opt.icon}</span>
        <span class="cost-item-value" data-cost-for={opt.id}>—</span>
        <span class="cost-item-label">{opt.displayName}</span>
      </div>
    ))}
  </div>

  <!-- Empty state -->
  <div id="cost-empty" class="cost-empty">
    <p class="cost-empty-text">💰 Calcula una ruta para ver el costo estimado</p>
  </div>

  <!-- Config section (collapsible) -->
  <button id="cost-config-toggle" class="cost-config-toggle">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"/>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
    </svg>
    <span>Ajustes de precio</span>
  </button>

  <div id="cost-config" class="cost-config" style="display:none;">
    <div class="config-group">
      <label class="config-label">Tarifa Global (CUP/km)</label>
      <input type="number" id="config-price-km" class="config-input" value="25" min="0" step="1" />
    </div>
    <div class="config-group">
      <label class="config-label">Cobro exacto del cliente (CUP)</label>
      <input type="number" id="config-manual-total" class="config-input" placeholder="Ej: 500 (Opcional)" min="0" step="1" />
    </div>
  </div>
</div>

<script>
  import { $allProfileResults, $costConfig, updateCostConfig } from '../lib/stores';
  import { calculateTripCost } from '../lib/cost';
  import { formatCUP } from '../lib/cost';
  import { saveCostConfig, loadCostConfig } from '../lib/db';
  import { vibrateTap } from '../lib/haptics';

  const costResult = document.getElementById('cost-result')!;
  const costTotal = document.getElementById('cost-total')!;
  const costFuel = document.getElementById('cost-fuel')!;
  const costGrid = document.getElementById('cost-grid')!;
  const costEmpty = document.getElementById('cost-empty')!;
  const configToggle = document.getElementById('cost-config-toggle')!;
  const configPanel = document.getElementById('cost-config')!;

  // Config inputs
  const inputPriceKm = document.getElementById('config-price-km') as HTMLInputElement;
  const inputManualTotal = document.getElementById('config-manual-total') as HTMLInputElement;

  // Local state for manual override
  let manualOverride: number | null = null;
  // Hold the last calculated primary result distance
  let currentDistanceMeters = 0;

  // ---- Load persisted config ----
  loadCostConfig().then((config) => {
    $costConfig.set(config);
    inputPriceKm.value = String(config.pricePerKm);
  });

  // ---- Config toggle ----
  configToggle.addEventListener('click', () => {
    const isOpen = configPanel.style.display !== 'none';
    configPanel.style.display = isOpen ? 'none' : 'grid';
    vibrateTap();
  });

  // ---- Config input handlers ----
  function onConfigChange() {
    const newConfig = {
      pricePerKm: parseInt(inputPriceKm.value) || 0,
    };
    updateCostConfig(newConfig);
    saveCostConfig($costConfig.get());

    const manualVal = parseInt(inputManualTotal.value);
    manualOverride = isNaN(manualVal) ? null : manualVal;

    // Re-render costs
    renderCosts();
  }

  inputPriceKm.addEventListener('input', onConfigChange);
  inputManualTotal.addEventListener('input', onConfigChange);

  // ---- Render costs ----
  function renderCosts() {
    const results = $allProfileResults.get();
    const config = $costConfig.get();

    if (results.length === 0) {
      costResult.style.display = 'none';
      costGrid.style.display = 'none';
      costEmpty.style.display = 'block';
      return;
    }

    costEmpty.style.display = 'none';
    costGrid.style.display = 'grid';
    costFuel.style.display = 'none'; // We don't display fuel portion anymore

    // Find the primary routing
    const primaryResult = results.find((r) => r.profile === 'driving-car') || results[0];
    currentDistanceMeters = primaryResult?.distance || 0;

    // Display the specific Transport Card estimates based globally
    results.forEach((r) => {
      const distanceKm = r.distance / 1000;
      const suggestedCup = distanceKm * config.pricePerKm;
      const finalCost = manualOverride !== null ? manualOverride : suggestedCup;

      const valueEl = document.querySelector(`[data-cost-for="${r.profile}"]`);
      if (valueEl) {
        valueEl.textContent = finalCost > 0 ? formatCUP(finalCost) : 'Gratis';
      }
    });

    // Display primary cost banner
    if (primaryResult) {
      const distanceKm = currentDistanceMeters / 1000;
      const suggestedCup = distanceKm * config.pricePerKm;
      const finalCost = manualOverride !== null ? manualOverride : suggestedCup;

      costResult.style.display = 'flex';
      costTotal.textContent = finalCost > 0 ? formatCUP(finalCost) : 'Gratis';
    }
  }

  $allProfileResults.subscribe(renderCosts);
  $costConfig.subscribe(renderCosts);
</script>

<style>
  .cost-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Main cost */
  .cost-result {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.125rem;
    border-radius: 0.875rem;
    background: linear-gradient(135deg, oklch(0.45 0.18 155), oklch(0.55 0.22 155));
    color: white;
    animation: slideUp 0.25s ease;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .cost-main {
    display: flex;
    flex-direction: column;
  }

  .cost-amount {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .cost-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.75;
  }

  .cost-fuel {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    background: rgba(255,255,255,0.15);
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .fuel-icon {
    font-size: 0.875rem;
  }

  /* Cost grid */
  .cost-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  @media (max-width: 400px) {
    .cost-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cost-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: 0.625rem 0.25rem;
    border-radius: 0.625rem;
    background: var(--bg);
    border: 1px solid oklch(0.5 0 0 / 0.06);
    text-align: center;
  }

  .cost-item-icon {
    font-size: 1.125rem;
    line-height: 1;
  }

  .cost-item-value {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text);
  }

  .cost-item-label {
    font-size: 0.625rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Empty */
  .cost-empty {
    text-align: center;
    padding: 1.5rem;
  }

  .cost-empty-text {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Config toggle */
  .cost-config-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.5rem;
    border: none;
    background: none;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .cost-config-toggle:hover {
    color: var(--text);
  }

  /* Config panel */
  .cost-config {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--bg);
    border-radius: 0.75rem;
    border: 1px solid oklch(0.5 0 0 / 0.08);
    animation: slideUp 0.2s ease;
  }

  @media (max-width: 380px) {
    .cost-config {
      grid-template-columns: 1fr;
    }
  }

  .config-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .config-label {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .config-input {
    width: 100%;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    border: 1px solid oklch(0.5 0 0 / 0.1);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .config-input:focus {
    border-color: var(--color-brand-400);
  }
</style>
