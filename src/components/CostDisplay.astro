---
/**
 * CostDisplay.astro — Trip cost calculator card
 * Shows estimated cost + fuel usage, with editable config.
 */
import { TRANSPORT_OPTIONS } from '../lib/types';
---

<div id="cost-panel" class="cost-panel">
  <!-- Vehicle Selector -->
  <div class="vehicle-selector">
    {TRANSPORT_OPTIONS.map((opt) => (
      <button class="vehicle-btn" data-profile={opt.id}>
        <span class="vehicle-icon">{opt.icon}</span>
        <span class="vehicle-label">{opt.displayName}</span>
      </button>
    ))}
  </div>

  <!-- Main cost display -->
  <div id="cost-result" class="cost-result" style="display:none;">
    <div class="cost-main">
      <span class="cost-amount" id="cost-total">—</span>
      <span class="cost-label" id="cost-label-text">costo estimado</span>
    </div>
  </div>

  <!-- Empty state -->
  <div id="cost-empty" class="cost-empty">
    <p class="cost-empty-text">💰 Calcula una ruta para ver el costo</p>
  </div>

  <!-- Config panel -->
  <div id="cost-config" class="cost-config">
    <div class="config-group">
      <label class="config-label">Tu Tarifa (CUP/km)</label>
      <input type="number" id="config-price-km" class="config-input" value="25" min="0" step="1" />
    </div>
    <div class="config-group">
      <label class="config-label">Monto Exacto a Cobrar (CUP)</label>
      <input type="number" id="config-manual-total" class="config-input" placeholder="Opcional" min="0" step="1" />
    </div>
  </div>
</div>

<script>
  import { $allProfileResults, $costConfig, updateCostConfig, $routeParams } from '../lib/stores';
  import { calculateTripCost } from '../lib/cost';
  import { formatCUP } from '../lib/cost';
  import { saveCostConfig, loadCostConfig } from '../lib/db';
  import { vibrateTap } from '../lib/haptics';

  const costResult = document.getElementById('cost-result')!;
  const costTotal = document.getElementById('cost-total')!;
  const costLabelText = document.getElementById('cost-label-text')!;
  const costEmpty = document.getElementById('cost-empty')!;
  const vehicleBtns = document.querySelectorAll('.vehicle-btn');

  // Config inputs
  const inputPriceKm = document.getElementById('config-price-km') as HTMLInputElement;
  const inputManualTotal = document.getElementById('config-manual-total') as HTMLInputElement;

  // Local state for manual override
  let manualOverride: number | null = null;
  let currentDistanceMeters = 0;

  // ---- Load persisted config ----
  loadCostConfig().then((config) => {
    $costConfig.set(config);
    inputPriceKm.value = String(config.pricePerKm);
  });

  // ---- Vehicle Selection ----
  vehicleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      vibrateTap();
      const profile = (btn as HTMLElement).dataset.profile as any;
      $routeParams.set({ profile });
      // Trigger route calculation to refresh path on map
      import('../lib/routing').then(r => r.calculateAllProfilesDebounced(100));
    });
  });

  $routeParams.subscribe((params) => {
    vehicleBtns.forEach(btn => {
      if ((btn as HTMLElement).dataset.profile === params.profile) {
        btn.classList.add('vehicle-btn--active');
      } else {
        btn.classList.remove('vehicle-btn--active');
      }
    });
    renderCosts();
  });

  // ---- Config input handlers ----
  function onConfigChange() {
    const newConfig = {
      pricePerKm: parseInt(inputPriceKm.value) || 0,
    };
    updateCostConfig(newConfig);
    saveCostConfig($costConfig.get());

    const manualVal = parseInt(inputManualTotal.value);
    manualOverride = isNaN(manualVal) ? null : manualVal;

    renderCosts();
  }

  inputPriceKm.addEventListener('input', onConfigChange);
  inputManualTotal.addEventListener('input', onConfigChange);

  // ---- Render costs ----
  function renderCosts() {
    const results = $allProfileResults.get();
    const config = $costConfig.get();
    const currentProfile = $routeParams.get().profile || 'driving-car';

    if (results.length === 0) {
      costResult.style.display = 'none';
      costEmpty.style.display = 'block';
      return;
    }

    costEmpty.style.display = 'none';

    // Find the current routing
    const primaryResult = results.find((r) => r.profile === currentProfile) || results[0];
    currentDistanceMeters = primaryResult?.distance || 0;

    // Display primary cost banner
    if (primaryResult) {
      const distanceKm = currentDistanceMeters / 1000;
      const suggestedCup = distanceKm * config.pricePerKm;
      const finalCost = manualOverride !== null ? manualOverride : suggestedCup;

      costResult.style.display = 'flex';
      costTotal.textContent = finalCost > 0 ? formatCUP(finalCost) : 'Gratis';
      costLabelText.textContent = manualOverride !== null ? 'cobro exacto definido' : 'costo sugerido (x Km)';
    }
  }

  $allProfileResults.subscribe(renderCosts);
  $costConfig.subscribe(renderCosts);
</script>

<style>
  .cost-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Main cost */
  .cost-result {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.125rem;
    border-radius: 0.875rem;
    background: linear-gradient(135deg, oklch(0.45 0.18 155), oklch(0.55 0.22 155));
    color: white;
    animation: slideUp 0.25s ease;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .cost-main {
    display: flex;
    flex-direction: column;
  }

  .cost-amount {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .cost-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.75;
  }

  /* Vehicle Selector */
  .vehicle-selector {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .vehicle-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.625rem 0.25rem;
    border-radius: 0.625rem;
    background: var(--bg);
    border: 2px solid transparent;
    box-shadow: 0 1px 3px oklch(0 0 0 / 0.05);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .vehicle-btn:hover {
    background: var(--bg-elevated);
  }

  .vehicle-btn--active {
    border-color: var(--color-brand-500);
    background: oklch(0.55 0.20 250 / 0.08);
  }

  .vehicle-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  .vehicle-label {
    font-size: 0.625rem;
    font-family: var(--font-sans);
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
  }

  .vehicle-btn--active .vehicle-label {
    color: var(--color-brand-500);
  }

  /* Empty */
  .cost-empty {
    text-align: center;
    padding: 1.5rem;
  }

  .cost-empty-text {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Config panel */
  .cost-config {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--bg);
    border-radius: 0.75rem;
    border: 1px solid oklch(0.5 0 0 / 0.08);
  }

  @media (max-width: 380px) {
    .cost-config {
      grid-template-columns: 1fr;
    }
  }

  .config-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .config-label {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .config-input {
    width: 100%;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    border: 1px solid oklch(0.5 0 0 / 0.1);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .config-input:focus {
    border-color: var(--color-brand-400);
  }
</style>
